              "args": [
                "--component",
                "toolchain"
              ]
            }
          },
          {
            "id": "verifier",
            "port": "verifier",
            "supported_features": [
              "core.call.sync@1",
              "core.value.scalar@1",
              "core.value.record@1",
              "core.buffer.copy@1",
              "core.resource.explicit-close@1"
            ],
            "entrypoint": {
              "kind": "process",
              "path": "bin/madb-dart-adapter",
              "args": [
                "--component",
                "verifier"
              ]
            }
          },
          {
            "id": "packager",
            "port": "artifact-packager",
            "supported_features": [],
            "entrypoint": {
              "kind": "process",
              "path": "bin/madb-dart-adapter",
              "args": [
                "--component",
                "packager"
              ]
