              "language": "c",
              "runtime": "native"
            },
            "consumer": {
              "language": "dart",
              "runtime": "dart-native"
            },
            "directions": [
              "consumer-to-provider"
            ],
            "targets": [
              {
                "os": "macos",
                "arch": "arm64",
                "abi": "aarch64-apple-darwin"
              }
            ],
            "supported_features": [
              "core.call.sync@1",
              "core.value.scalar@1",
              "core.value.record@1",
