    {
      "rule": "Metadata resolves policies against the same actual context.project, then rechecks completed contract and authoritative policy/provenance",
      "evidence": "native/composition.rs:33,40-45; lib.rs:123-187",
      "independent_probe": "Coherently repinned actual project change to blocking=non-blocking appears in completed call policy"
