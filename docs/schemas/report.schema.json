{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madb:schema:report:1",
  "title": "MadB report v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "madb.report/1"
    },
    "run_id": {
      "$ref": "urn:madb:schema:common:1#/$defs/id"
    },
    "identity": {
      "$ref": "urn:madb:schema:common:1#/$defs/evidence_identity"
    },
    "selector": {
      "$ref": "urn:madb:schema:common:1#/$defs/selector"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:madb:schema:common:1#/$defs/id"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "$ref": "urn:madb:schema:common:1#/$defs/digest"
          },
          "host": {
            "$ref": "urn:madb:schema:common:1#/$defs/id"
          },
          "target": {
            "$ref": "urn:madb:schema:common:1#/$defs/id"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 4096
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "host",
          "target",
          "source",
          "arguments"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "urn:madb:schema:common:1#/$defs/id"
          },
          "case_digest": {
            "$ref": "urn:madb:schema:common:1#/$defs/digest"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "unsupported",
              "blocked"
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "success"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "rejection"
                  },
                  "code": {
                    "$ref": "urn:madb:schema:common:1#/$defs/id"
                  },
                  "stage": {
                    "enum": [
                      "parse",
                      "format",
                      "identity",
                      "policy",
                      "capability",
                      "generate",
                      "compile",
                      "link",
                      "load",
                      "run",
                      "cleanup"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "code",
                  "stage"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "isolated-abort"
                  },
                  "stage": {
                    "const": "run"
                  },
                  "exit_code": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255
                  },
                  "reason": {
                    "$ref": "urn:madb:schema:common:1#/$defs/id"
                  }
                },
                "required": [
                  "kind",
                  "stage",
                  "exit_code",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "actual": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "success",
                  "rejection",
                  "isolated-abort",
                  "unavailable",
                  "not-run"
                ]
              },
              "code": {
                "oneOf": [
                  {
                    "$ref": "urn:madb:schema:common:1#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "oneOf": [
                  {
                    "$ref": "urn:madb:schema:common:1#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "kind",
              "code",
              "stage",
              "exit_code",
              "reason"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "success"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "code": {
                      "type": "null"
                    },
                    "stage": {
                      "type": "null"
                    },
                    "exit_code": {
                      "const": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "rejection"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "code": {
                      "$ref": "urn:madb:schema:common:1#/$defs/id"
                    },
                    "stage": {
                      "$ref": "urn:madb:schema:common:1#/$defs/id"
                    },
                    "exit_code": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "isolated-abort"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "code": {
                      "type": "null"
                    },
                    "stage": {
                      "const": "run"
                    },
                    "exit_code": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 255
                    },
                    "reason": {
                      "$ref": "urn:madb:schema:common:1#/$defs/id"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "unavailable",
                        "not-run"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "code": {
                      "type": "null"
                    },
                    "stage": {
                      "type": "null"
                    },
                    "exit_code": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "evidence_level": {
            "enum": [
              "static",
              "generated",
              "compiled",
              "linked",
              "host-run",
              "target-run",
              "device-run"
            ]
          },
          "duration_ms": {
            "$ref": "urn:madb:schema:common:1#/$defs/safe_uint"
          },
          "resource_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "urn:madb:schema:common:1#/$defs/id"
                },
                "before": {
                  "$ref": "urn:madb:schema:common:1#/$defs/safe_uint"
                },
                "after": {
                  "$ref": "urn:madb:schema:common:1#/$defs/safe_uint"
                },
                "created": {
                  "$ref": "urn:madb:schema:common:1#/$defs/safe_uint"
                },
                "released": {
                  "$ref": "urn:madb:schema:common:1#/$defs/safe_uint"
                }
              },
              "required": [
                "name",
                "before",
                "after",
                "created",
                "released"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 4096
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "$ref": "urn:madb:schema:common:1#/$defs/id"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "location": {
                  "oneOf": [
                    {
                      "$ref": "urn:madb:schema:common:1#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "location"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 4096
          },
          "cleanup": {
            "enum": [
              "complete",
              "failed",
              "not-run"
            ]
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "urn:madb:schema:common:1#/$defs/file"
            },
            "minItems": 0,
            "maxItems": 4096
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "$ref": "urn:madb:schema:common:1#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "case_id",
          "case_digest",
          "status",
          "expected",
          "actual",
          "evidence_level",
          "duration_ms",
          "resource_observations",
          "diagnostics",
          "cleanup",
          "attachments",
          "blocked_by"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "extensions": {
      "$ref": "urn:madb:schema:common:1#/$defs/metadata"
    }
  },
  "required": [
    "schema",
    "run_id",
    "identity",
    "selector",
    "started_at",
    "environment",
    "results"
  ],
  "additionalProperties": false
}
