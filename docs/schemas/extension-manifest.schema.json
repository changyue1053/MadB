{
  "type": "object",
  "properties": {
    "schema": {
      "const": "madb.extension/1"
    },
    "example": {
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/namespacedId"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[A-Za-z0-9.-]+)?$"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ir": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "ir"
      ],
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "runtimes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "runtimes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "extension",
              "toolchain",
              "generator"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "template",
              "sdk",
              "documentation"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        },
        "required": [
          "kind",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "transport": {
          "const": "stdio-jsonl"
        },
        "network": {
          "enum": [
            "none",
            "requested"
          ]
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "transport",
        "network",
        "env"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*[.][a-z0-9][a-z0-9.-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Non-semantic metadata only. Runtime policy is not permitted here."
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "compatibility",
    "languages",
    "components",
    "dependencies",
    "routes",
    "assets",
    "execution"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madb:schema:extension-manifest:1",
  "title": "MadB extension manifest v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$",
      "maxLength": 128
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*[.][a-z0-9][a-z0-9.-]*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Relative package/workspace path; filesystem canonicalization and link checks remain mandatory.",
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)[.][.](/|$)"
          }
        },
        {
          "not": {
            "pattern": ":"
          }
        },
        {
          "not": {
            "pattern": "[\\\\]"
          }
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          }
        }
      ]
    },
    "componentRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*[.][a-z0-9][a-z0-9.-]*/[a-z][a-z0-9.-]*$"
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "language": {
          "$ref": "#/$defs/id"
        },
        "runtime": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "language",
        "runtime"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "os": {
          "$ref": "#/$defs/id"
        },
        "arch": {
          "$ref": "#/$defs/id"
        },
        "abi": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "os",
        "arch",
        "abi"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "enum": [
            "contract-reader",
            "generator",
            "toolchain",
            "verifier",
            "artifact-packager"
          ]
        },
        "supported_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "entrypoint": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "process"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "path",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "port",
        "supported_features",
        "entrypoint"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "provider": {
          "$ref": "#/$defs/endpoint"
        },
        "consumer": {
          "$ref": "#/$defs/endpoint"
        },
        "directions": {
          "type": "array",
          "items": {
            "enum": [
              "consumer-to-provider",
              "provider-to-host-callback"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "bindings": {
          "type": "object",
          "properties": {
            "contract-reader": {
              "$ref": "#/$defs/componentRef"
            },
            "generator": {
              "$ref": "#/$defs/componentRef"
            },
            "toolchain": {
              "$ref": "#/$defs/componentRef"
            },
            "verifier": {
              "$ref": "#/$defs/componentRef"
            },
            "artifact-packager": {
              "$ref": "#/$defs/componentRef"
            }
          },
          "required": [
            "contract-reader",
            "generator",
            "toolchain",
            "verifier",
            "artifact-packager"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "provider",
        "consumer",
        "directions",
        "targets",
        "supported_features",
        "restrictions",
        "bindings"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "properties": {
        "components": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "routes": {
          "minItems": 1
        }
      }
    }
  ]
}
