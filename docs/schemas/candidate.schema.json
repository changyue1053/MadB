{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madb:schema:candidate:1",
  "title": "MadB candidate v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "madb.candidate/1"
    },
    "candidate_digest": {
      "$ref": "urn:madb:schema:common:1#/$defs/digest"
    },
    "selector": {
      "$ref": "urn:madb:schema:common:1#/$defs/selector"
    },
    "generation_id": {
      "$ref": "urn:madb:schema:common:1#/$defs/digest"
    },
    "contract_digest": {
      "$ref": "urn:madb:schema:common:1#/$defs/digest"
    },
    "policy_digest": {
      "$ref": "urn:madb:schema:common:1#/$defs/digest"
    },
    "lock_digest": {
      "$ref": "urn:madb:schema:common:1#/$defs/digest"
    },
    "manifest_path": {
      "$ref": "urn:madb:schema:common:1#/$defs/path"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "urn:madb:schema:common:1#/$defs/file"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "urn:madb:schema:common:1#/$defs/file_ref"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "public_symbols": {
      "type": "array",
      "items": {
        "$ref": "urn:madb:schema:common:1#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "required_cases": {
      "type": "array",
      "items": {
        "$ref": "urn:madb:schema:common:1#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "build_evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:madb:schema:common:1#/$defs/file_ref"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schema",
    "candidate_digest",
    "selector",
    "generation_id",
    "contract_digest",
    "policy_digest",
    "lock_digest",
    "manifest_path",
    "files",
    "dependencies",
    "public_symbols",
    "required_cases",
    "build_evidence"
  ],
  "additionalProperties": false
}
