+package org.cpf.kotlin.akinterop
+
+/** Pure gate shared by production init and the host regression. Non-managed
+ * callers retain single-init behavior and never require the managed schema. */
+internal object ManagedAdmissionRules {
+    fun validate(managed: Boolean, schemaInstalled: Boolean, configMatches: Boolean,
+                 started: Boolean, previousClosed: Boolean, activeEntries: Int,
+                 currentEpoch: ULong, nextEpoch: ULong) {
+        if (!managed) {
+            check(!started) { "ManagedInteropAlreadyInitialized" }
+            return
+        }
+        check(schemaInstalled && configMatches) { "ManagedSchemaNotInstalled" }
+        check(nextEpoch > currentEpoch) { "ManagedEpochExhaustedOrReused" }
+        if (started) check(previousClosed && activeEntries == 0) { "ManagedPreviousEpochNotAcknowledged" }
+    }
+}
