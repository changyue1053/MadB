+// managed-akinterop-mainenv-v1. Rebuild cinterop and runtime together.
+// Token reservation precedes Kotlin StableRef allocation. Registry lock must
+// cover reserve/submit and release; these functions never wait for JavaScript.
+void *createManagedThreadSafeFunction(napi_env env, const char *name, size_t capacity);
