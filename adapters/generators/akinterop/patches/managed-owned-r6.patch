@@ -0,0 +1,86 @@
+/* MADB owned-runtime r5, derived from fixed r4. Internal boundary ownership only. */
+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package org.cpf.kotlin.akinterop.generate
+
+import kotlinx.cinterop.*
+import kotlin.native.concurrent.ThreadLocal
+import org.cpf.kotlin.akinterop.OhosFFIContext
+import org.cpf.kotlin.akinterop.types.ArkProxy
+import platform.ArkTS.ArkTS_Napi_NativeModule.*
+
+class ManagedBoundaryFailure(val code: String) : RuntimeException(code)
+interface ManagedReturnOwner {
+    val consumesDelivery: Boolean get() = false
+    fun releaseAfterEncoding(encoded: Boolean)
+}
+
+@ThreadLocal
+private var currentOwnedCall: ManagedOwnedCall? = null
+
+/** One scope per generated global entry; the outer managed entry keeps metadata
+ * alive across getters. Business owners are borrowed only after conversion. */
+class ManagedOwnedCall private constructor(private val parent: ManagedOwnedCall?) {
+    private var returnOwner: ManagedReturnOwner? = null
+    private var argument: ArkProxy? = null
+    private var claimed = false
+    private var encoded = false
+    val deliveryFailed: Boolean get() = returnOwner?.consumesDelivery == true && !encoded
+    fun encodingSucceeded() { encoded = true }
+    private val depth: Int = (parent?.depth ?: 0) + 1
+    companion object {
+        fun begin(): ManagedOwnedCall {
+            if ((currentOwnedCall?.depth ?: 0) >= 32) throw ManagedBoundaryFailure("ResourceExhausted")
+            return ManagedOwnedCall(currentOwnedCall).also { currentOwnedCall = it }
+        }
+        fun hold(owner: ManagedReturnOwner) {
+            val call = currentOwnedCall ?: throw ManagedBoundaryFailure("InternalFailure")
+            if (call.returnOwner != null) throw ManagedBoundaryFailure("InternalFailure")
+            call.returnOwner = owner
+        }
+        fun claimArgument(value: Any) {
+            val call = currentOwnedCall ?: throw ManagedBoundaryFailure("InternalFailure")
+            if (call.argument !== value || call.claimed) throw ManagedBoundaryFailure("InternalFailure")
+            call.claimed = true
+        }
+    }
+    fun trackArgument(value: Any?) {
+        if (value !is ArkProxy) return
+        if (argument != null) {
+            value.ref.close()
+            throw ManagedBoundaryFailure("Unsupported")
+        }
+        argument = value
+    }
+    fun close(): Boolean {
+        var okay = true
+        try {
+            val owner = returnOwner; returnOwner = null
+            try { owner?.releaseAfterEncoding(encoded) } catch (_: Throwable) { okay = false; OhosFFIContext.cleanupFailure() }
+            if (!claimed) try { argument?.ref?.close() } catch (_: Throwable) { okay = false; OhosFFIContext.cleanupFailure() }
+            argument = null
+        } finally { currentOwnedCall = parent }
+        return okay
+    }
+}
+
+fun reportManagedBoundaryError(env: napi_env?, failure: ManagedBoundaryFailure) = memScoped {
+    if (env == null) return@memScoped
+    val pending = alloc<BooleanVar>(); pending.value = false
+    if (napi_is_exception_pending(env, pending.ptr) != napi_ok || pending.value) return@memScoped
+    napi_throw_error(env, failure.code, failure.code)
+}
+
+/** This is only the no-user-code output conversion of an owned result, after
+ * its guard really released the delivery. Input getter exceptions never enter
+ * this function. A failure to clear/report remains a diagnostic, not a receipt. */
+fun reportManagedConsumedFailure(env: napi_env?) = memScoped {
+    if (env == null) return@memScoped
+    val pending = alloc<BooleanVar>(); pending.value = false
+    if (napi_is_exception_pending(env, pending.ptr) != napi_ok) { OhosFFIContext.cleanupFailure(); return@memScoped }
+    if (pending.value) {
+        val exception = alloc<napi_valueVar>(); exception.value = null
+        if (napi_get_and_clear_last_exception(env, exception.ptr) != napi_ok) { OhosFFIContext.cleanupFailure(); return@memScoped }
+    }
+    if (napi_throw_error(env, "DeliveryFailureConsumed", "Owned result encoding failed after disposal") != napi_ok)
+        OhosFFIContext.cleanupFailure()
+}
