@@ -0,0 +1,168 @@
+/* MADB development r4. Narrow generated Int/String value record support.
+ * This is not a general registry or the public C07 SDK surface. */
+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package org.cpf.kotlin.akinterop.generate
+
+import kotlinx.cinterop.*
+import org.cpf.kotlin.akinterop.OhosFFIContext
+import platform.ArkTS.ArkTS_Napi_NativeModule.*
+import platform.posix.size_tVar
+import kotlin.reflect.KClass
+import kotlin.reflect.KType
+import kotlin.math.floor
+
+// No NAPI values/refs are retained here. Installation is single-shot before KSP metadata.
+object ManagedRecordCodec {
+    private var klass: KClass<*>? = null
+    private var name: String? = null
+    private var fields: List<Pair<String, KClass<*>>> = emptyList()
+    private var decode: JS2KTConverter? = null
+    private var encode: KT2JSConverter? = null
+    fun install(type: KClass<*>, qualifiedName: String, schema: List<Pair<String, KClass<*>>>,
+                decoder: JS2KTConverter, encoder: KT2JSConverter) {
+        OhosFFIContext.requireRecordInstallPhase()
+        check(type.qualifiedName == qualifiedName) { "ManagedRecordClassIdentity" }
+        check(klass == null && schema.size == 2 && schema.map { it.first }.distinct().size == 2 &&
+            schema.map { it.second }.toSet() == setOf(Int::class, String::class)) { "ManagedRecordUnsupportedShape" }
+        val prepared = schema.toList() // allocation before any install marker
+        name = qualifiedName; fields = prepared; decode = decoder; encode = encoder; klass = type
+    }
+    internal fun clearUncommitted() { klass = null; name = null; fields = emptyList(); decode = null; encode = null }
+    fun decoder(type: KType): JS2KTConverter? {
+        if (type.classifier != klass || klass == null) return null
+        check(!type.isMarkedNullable) { "ManagedRecordNullableUnsupported" }
+        return decode
+    }
+    fun encoder(type: KType): KT2JSConverter? {
+        if (type.classifier != klass || klass == null) return null
+        check(!type.isMarkedNullable) { "ManagedRecordNullableUnsupported" }
+        return encode
+    }
+    fun matchesMetadata(meta: KSPClass): Boolean {
+        if (meta.qualifiedName != name || klass == null) return false
+        check(meta !is KSPInterface && meta.functions.isEmpty() && meta.properties.size == fields.size) { "ManagedRecordMetadataShape" }
+        check(fields.all { (field, type) ->
+            val p = meta.properties[field]
+            p != null && !p.isStatic && p.setter == null &&
+                p.getter?.returnType?.classifier == type && p.getter?.returnType?.isMarkedNullable == false
+        }) { "ManagedRecordMetadataFields" }
+        check(meta.constructors.all { c -> c.invokable.params.map { it.classifier } == fields.map { it.second } }) { "ManagedRecordMetadataConstructor" }
+        return true
+    }
+}
+
+class ManagedRecordCodecException(val category: String, message: String) : RuntimeException(message)
+
+fun reportManagedRecordError(env: napi_env?, failure: ManagedRecordCodecException) = memScoped {
+    if (env == null) return@memScoped
+    val pending = alloc<BooleanVar>(); pending.value = false
+    if (napi_is_exception_pending(env, pending.ptr) != napi_ok || pending.value) return@memScoped
+    when (failure.category) {
+        "type" -> napi_throw_type_error(env, "ERR_RECORD_TYPE", failure.message)
+        "range" -> napi_throw_range_error(env, "ERR_RECORD_RANGE", failure.message)
+        else -> napi_throw_error(env, "ERR_RECORD_NAPI", failure.message)
+    }
+}
+
+// Every out-parameter starts initialized and is read only after a checked status.
+object ManagedRecordValues {
+    private fun status(value: napi_status, operation: String) {
+        if (value != napi_ok) throw ManagedRecordCodecException("napi", "Record NAPI: $operation")
+    }
+    private fun owner(env: napi_env?) {
+        check(env != null && env == OhosFFIContext.tlsEnv) { "ManagedRecordWrongOwner" }
+    }
+    private fun type(env: napi_env?, value: napi_value?, expected: napi_valuetype, field: String) = memScoped {
+        if (value == null) throw ManagedRecordCodecException("type", "$field is missing")
+        val actual = alloc<napi_valuetype.Var>(); actual.value = napi_valuetype.napi_undefined
+        status(napi_typeof(env, value, actual.ptr), "typeof $field")
+        if (actual.value != expected) throw ManagedRecordCodecException("type", "$field has wrong type")
+    }
+    fun objectValue(env: napi_env?, value: napi_value?): napi_value? = memScoped {
+        owner(env); type(env, value, napi_valuetype.napi_object, "record")
+        val nil = alloc<napi_valueVar>(); nil.value = null
+        status(napi_get_null(env, nil.ptr), "null")
+        val same = alloc<BooleanVar>(); same.value = false
+        status(napi_strict_equals(env, value, nil.value, same.ptr), "null check")
+        if (same.value) throw ManagedRecordCodecException("type", "record must not be null")
+        val array = alloc<BooleanVar>(); array.value = false
+        status(napi_is_array(env, value, array.ptr), "array check")
+        if (array.value) throw ManagedRecordCodecException("type", "record must not be array")
+        value
+    }
+    fun property(env: napi_env?, obj: napi_value?, field: String): napi_value? = memScoped {
+        val out = alloc<napi_valueVar>(); out.value = null
+        status(napi_get_named_property(env, obj, field, out.ptr), "get $field")
+        out.value
+    }
+    fun int32(env: napi_env?, value: napi_value?, field: String): Int = memScoped {
+        type(env, value, napi_valuetype.napi_number, field)
+        val out = alloc<DoubleVar>(); out.value = 0.0
+        status(napi_get_value_double(env, value, out.ptr), "number $field")
+        val number = out.value
+        if (!number.isFinite() || floor(number) != number || number < Int.MIN_VALUE.toDouble() || number > Int.MAX_VALUE.toDouble())
+            throw ManagedRecordCodecException("range", "$field must be finite integral int32")
+        number.toInt() // -0 is accepted and normalized to +0 on the copied result.
+    }
+    fun string(env: napi_env?, value: napi_value?, field: String): String = memScoped {
+        type(env, value, napi_valuetype.napi_string, field)
+        val length = alloc<size_tVar>(); length.value = 0uL
+        status(napi_get_value_string_utf16(env, value, null, 0uL, length.ptr), "UTF16 length $field")
+        if (length.value > 1024uL) throw ManagedRecordCodecException("range", "$field exceeds UTF16 bound")
+        val count = length.value.toInt()
+        val chars = allocArray<UShortVar>(count + 1)
+        val copied = alloc<size_tVar>(); copied.value = 0uL
+        status(napi_get_value_string_utf16(env, value, chars, (count + 1).toULong(), copied.ptr), "UTF16 read $field")
+        if (copied.value != length.value) throw ManagedRecordCodecException("napi", "Record string length changed")
+        val result = CharArray(count) { chars[it].toInt().toChar() }.concatToString()
+        validateString(result, field)
+        result
+    }
+    fun validateString(text: String, field: String) {
+        if (text.length > 1024) throw ManagedRecordCodecException("range", "$field exceeds UTF16 bound")
+        var bytes = 0; var index = 0
+        while (index < text.length) {
+            val ch = text[index++].code
+            bytes += when {
+                ch < 0x80 -> 1
+                ch < 0x800 -> 2
+                ch in 0xD800..0xDBFF -> {
+                    if (index == text.length || text[index].code !in 0xDC00..0xDFFF)
+                        throw ManagedRecordCodecException("type", "$field contains unpaired surrogate")
+                    index++; 4
+                }
+                ch in 0xDC00..0xDFFF -> throw ManagedRecordCodecException("type", "$field contains unpaired surrogate")
+                else -> 3
+            }
+            if (bytes > 1024) throw ManagedRecordCodecException("range", "$field exceeds 1024 UTF8 bytes")
+        }
+    }
+    fun newObject(env: napi_env?): napi_value? = memScoped {
+        owner(env)
+        val out = alloc<napi_valueVar>(); out.value = null
+        status(napi_create_object(env, out.ptr), "create object"); out.value
+    }
+    private fun ownProperty(env: napi_env?, obj: napi_value?, field: String, value: napi_value?) = memScoped {
+        // Define own data properties: do not invoke an inherited Object.prototype setter.
+        val descriptor = alloc<napi_property_descriptor>()
+        descriptor.utf8name = field.cstr.ptr
+        descriptor.name = null; descriptor.method = null; descriptor.getter = null; descriptor.setter = null
+        descriptor.value = value; descriptor.data = null
+        descriptor.attributes = napi_writable or napi_enumerable or napi_configurable
+        status(napi_define_properties(env, obj, 1uL, descriptor.ptr), "define $field")
+    }
+    fun setInt32(env: napi_env?, obj: napi_value?, field: String, value: Int) = memScoped {
+        val out = alloc<napi_valueVar>(); out.value = null
+        status(napi_create_int32(env, value, out.ptr), "create int32")
+        ownProperty(env, obj, field, out.value)
+    }
+    fun setString(env: napi_env?, obj: napi_value?, field: String, text: String) = memScoped {
+        validateString(text, field)
+        val chars = allocArray<UShortVar>(text.length + 1)
