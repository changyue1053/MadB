@@ -0,0 +1,28 @@
+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package org.cpf.kotlin.akinterop.generate
+
+import kotlinx.cinterop.*
+
+/** Immutable per-DSO KSP inventory. This bounded ordinal is not an address or
+ * an epoch-owned descriptor. Saved JS functions cannot retain a freed token. */
+internal object ManagedGlobalInventory {
+    private var methods: List<KSPMethod>? = null
+    fun install() {
+        check(methods == null) { "ManagedInventoryAlreadyInstalled" }
+        val prepared = KSPGlobalFunctionRegister.methods.values.sortedBy { it.name }
+        check(prepared.isNotEmpty() && prepared.size <= 256) { "ManagedInventoryCapacity" }
+        methods = prepared // all allocation/validation precedes publication
+    }
+    fun clearUncommitted() { methods = null }
+    fun all(): List<KSPMethod> = methods ?: error("ManagedInventoryNotInstalled")
+    fun data(index: Int): COpaquePointer {
+        check(index in all().indices)
+        return (index + 1).toLong().toCPointer<ByteVar>()!!
+    }
+    fun method(data: COpaquePointer?): KSPMethod {
+        val ordinal = data?.rawValue?.toLong() ?: 0L
+        val inventory = all()
+        if (ordinal < 1L || ordinal > inventory.size.toLong()) throw ManagedBoundaryFailure("InvalidArgument")
+        return inventory[ordinal.toInt() - 1]
+    }
+}
