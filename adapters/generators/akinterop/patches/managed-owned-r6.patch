+void releaseManagedThreadSafeFunction(void *handle);
+// 0 outstanding, 1 allocated, 2 released, 3 created, 4 finalized,
+// 5 null-env disposal, 6 uncertain (monotonic), 7 rejected, 8 native API errors,
+// 9 contexts created, 10 contexts destroyed (independent of finalize ordering).
+uint64_t managedThreadSafeFunctionMetric(int metric);
+const char *managedInteropPatchVersion(void);
+// r3 internal shutdown integration ABI; not a generated application SDK surface.
+// 0 phase; 1 active entries; 2 rejected entries; 3 Busy; 4 accepted requests;
+// 5 refs owned; 6 refs created; 7 refs released; 8 descriptors owned;
+// 9 descriptors created; 10 descriptors released; 11 hooks owned; 12 hooks added;
+// 13 hooks removed explicitly; 14 hooks actually invoked; 15 failures;
+// 16 unsupported requests; 17 final cleanup snapshot published;
+// 18 monotonic event sequence; 19 Open; 20 Closing gate; 21 refs/drain snapshot;
+// 22 finalizer holder released; 23 last context destroyed (sequence numbers);
+// 24 class constructor refs owned; 25 created; 26 released.
+void managedShutdownSet(int metric, uint64_t value);
+void managedShutdownAdd(int metric, int64_t delta);
+uint64_t managedShutdownMetric(int metric);
+// 0 uninitialized, 1 open, 2 closing, 3 awaiting finalizer, 4 closed, 5 failed.
+// Pure read: never drives cleanup and does not count itself as an active entry.
+int managedShutdownState(void);
+
 #ifdef __cplusplus
 }
 #endif
