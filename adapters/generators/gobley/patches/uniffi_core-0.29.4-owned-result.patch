@@ -30,6 +31,36 @@
 /// See `LiftReturn` trait for how this is implemented.
 pub type ForeignFutureCallback<FfiType> =
     extern "C" fn(oneshot_handle: u64, ForeignFutureResult<FfiType>);
+
+// A dropped receiver must still consume transferred FFI allocations. The ordinary
+// path keeps lifting on the awaiting Rust task; only abandoned results lift during
+// cleanup. MadB's profile permits thread-independent generated lifts only.
+struct OwnedForeignFutureResult<T: LiftReturn<UT>, UT> {
+    value: Option<ForeignFutureResult<T::ReturnType>>,
+    marker: PhantomData<fn() -> (T, UT)>,
+}
+
+impl<T: LiftReturn<UT>, UT> OwnedForeignFutureResult<T, UT> {
+    fn new(value: ForeignFutureResult<T::ReturnType>) -> Self {
+        Self { value: Some(value), marker: PhantomData }
+    }
+
+    fn take(mut self) -> ForeignFutureResult<T::ReturnType> {
+        self.value.take().expect("foreign result consumed once")
+    }
+}
+
+impl<T: LiftReturn<UT>, UT> Drop for OwnedForeignFutureResult<T, UT> {
+    fn drop(&mut self) {
+        if let Some(value) = self.value.take() {
+            // Generated lifts consume success/error allocations. A callback error
+            // may panic after consuming its message; never unwind from C cleanup.
+            let _ = catch_unwind(AssertUnwindSafe(|| {
+                drop(T::lift_foreign_return(value.return_value, value.call_status));
+            }));
+        }
+    }
+}
 
