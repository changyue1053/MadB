+// Owns the native future until completion cleanup and any concurrent cancel call exit.
+// No lock is held across native code: cancellation may synchronously resume a continuation.
+private final class UniffiRustFutureCancellation: @unchecked Sendable {
+    private let lock = NSLock()
+    private var handle: UInt64?
+    private var requested = false
+    private var cancelling = false
+    private var cancellationIssued = false
+    private var completionClaimed = false
+    private var finished = false
+    private let cancelFunc: (@Sendable (UInt64) -> Void)?
+    private let freeFunc: @Sendable (UInt64) -> Void
+
+    init(cancelFunc: (@Sendable (UInt64) -> Void)?, freeFunc: @escaping @Sendable (UInt64) -> Void) {
+        self.cancelFunc = cancelFunc
+        self.freeFunc = freeFunc
+    }
+    func install(_ value: UInt64) {
+        lock.lock()
+        precondition(handle == nil && !finished)
+        handle = value
+        let shouldCancel = requested && !cancellationIssued
+        if shouldCancel { cancelling = true; cancellationIssued = true }
+        lock.unlock()
+        if shouldCancel { cancelFunc?(value); endCancellation() }
+    }
+    func cancel() {
+        guard let cancelFunc else { return }
+        lock.lock()
+        requested = true
+        let value = (!finished && !completionClaimed && !cancellationIssued) ? handle : nil
+        if value != nil { cancelling = true; cancellationIssued = true }
+        lock.unlock()
+        if let value { cancelFunc(value); endCancellation() }
+    }
+    func claimCompletion() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        if requested { return false }
+        completionClaimed = true
+        return true
+    }
+    func finish() {
+        lock.lock()
+        finished = true
+        let value = cancelling ? nil : handle
+        if value != nil { handle = nil }
+        lock.unlock()
+        if let value { freeFunc(value) }
+    }
+    private func endCancellation() {
+        lock.lock()
+        cancelling = false
+        let value = finished ? handle : nil
+        if value != nil { handle = nil }
+        lock.unlock()
+        if let value { freeFunc(value) }
+    }
+}
 
