buildscript {
    repositories {
        maven(url = uri("@MAVEN@"))
    }
    dependencies {
        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:2.2.21-1.1.0")
        classpath("org.cpf.kotlin:akinterop-gradle-plugin:1.1.0")
    }
}
allprojects {
    group = "org.madb.development.cpf"
    version = "1.1.0-madb-owned-runtime-r6"
}
