org.gradle.jvmargs=-Xmx3g -Dfile.encoding=UTF-8 -Duser.home=@PROJECT@/home -Djava.io.tmpdir=@PROJECT@/tmp
org.gradle.java.installations.auto-download=false
org.gradle.java.installations.auto-detect=false
org.gradle.java.installations.paths=@JAVA_HOME@
org.gradle.caching=false
org.gradle.parallel=false
ksp.useKSP2=false
kotlin.native.cacheKind.ohosArm64=none
kotlin.native.home=@COMPILER_HOME@
kotlin.compiler.execution.strategy=in-process
systemProp.org.gradle.internal.http.socketTimeout=30000
systemProp.org.gradle.internal.http.connectionTimeout=15000
