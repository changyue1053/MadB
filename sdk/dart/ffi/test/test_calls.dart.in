part of '../madb_dart_ffi.dart';

// Test-only ABI declarations. Production adapters are produced by fixed ffigen.
final class _ErrorWire extends Struct {
  @Uint32()
  external int domain;
  @Int32()
  external int code;
}

final class _CreateWire extends Struct {
  @Uint32()
  external int kind;
  @Int32()
  external int status;
  external _ErrorWire error;
  @Uint64()
  external int handle;
}

_NativeCalls _generatedCalls(DynamicLibrary library) => _TestCalls(library);

final class _TestCalls implements _EngineNativeCalls {
  final DynamicLibrary library;
  _TestCalls(this.library);

  late final _path = library.lookupFunction<Pointer<Uint8> Function(Uint32),
      Pointer<Uint8> Function(int)>('madb_dart_native_path');
  late final _bootstrap = library.lookupFunction<Int32 Function(Pointer<Uint8>),
      int Function(Pointer<Uint8>)>('madb_dart_bootstrap');
  late final _create = library.lookupFunction<Void Function(Pointer<_CreateWire>),
      void Function(Pointer<_CreateWire>)>('madb_dart_create_checked');
  late final _checksum = library.lookupFunction<
      Int32 Function(Uint64, Pointer<Uint8>, Uint64, Pointer<Uint64>, Pointer<_ErrorWire>),
      int Function(int, Pointer<Uint8>, int, Pointer<Uint64>, Pointer<_ErrorWire>)>('madb_dart_checksum');
  late final _request = library.lookupFunction<Int32 Function(Uint64, Pointer<_ErrorWire>),
      int Function(int, Pointer<_ErrorWire>)>('madb_dart_request_close');
  late final _await = library.lookupFunction<Int32 Function(Uint64, Uint32, Pointer<_ErrorWire>),
      int Function(int, int, Pointer<_ErrorWire>)>('madb_dart_await_closed');
  late final _release = library.lookupFunction<Int32 Function(Uint64, Pointer<_ErrorWire>),
      int Function(int, Pointer<_ErrorWire>)>('madb_dart_release_handle');

  @override
  String nativePath(int symbolIndex) {
    final pointer = _path(symbolIndex);
    _checkOutput(pointer != nullptr, 'nativePath');
    final bytes = <int>[];
    for (var i = 0; i < 4096; i++) {
      final byte = pointer[i];
      if (byte == 0) return utf8.decode(bytes, allowMalformed: false);
      bytes.add(byte);
    }
    throw const MadbContractException._('nativePath', 'invalidOutput');
  }

  @override
  _IdentityResult bootstrap() {
    final output = ffi.calloc<Uint8>(64);
    try {
      final status = _bootstrap(output);
      return (status: status, domain: 0, code: 0,
          identity: Uint8List.fromList(output.asTypedList(64)));
    } finally { ffi.calloc.free(output); }
  }

  @override
  _CreateResult createChecked() {
    final output = ffi.calloc<_CreateWire>();
    try {
      _create(output);
      return (kind: output.ref.kind, status: output.ref.status,
          domain: output.ref.error.domain, code: output.ref.error.code,
          handle: output.ref.handle);
    } finally { ffi.calloc.free(output); }
  }

  @override
  _ScalarResult checksum(int handle, Uint8List bytes) {
    final data = bytes.isEmpty ? nullptr.cast<Uint8>() : ffi.calloc<Uint8>(bytes.length);
    final output = ffi.calloc<Uint64>();
    final error = ffi.calloc<_ErrorWire>();
    try {
      if (bytes.isNotEmpty) data.asTypedList(bytes.length).setAll(0, bytes);
      final status = _checksum(handle, data, bytes.length, output, error);
      return (status: status, domain: error.ref.domain, code: error.ref.code, value: output.value);
    } finally {
      if (data != nullptr) ffi.calloc.free(data);
      ffi.calloc.free(output); ffi.calloc.free(error);
    }
  }

  _StatusResult _status(int Function(Pointer<_ErrorWire>) invoke) {
    final error = ffi.calloc<_ErrorWire>();
    try {
      final status = invoke(error);
      return (status: status, domain: error.ref.domain, code: error.ref.code);
    } finally { ffi.calloc.free(error); }
  }

  @override
  _StatusResult requestClose(int handle) => _status((error) => _request(handle, error));
  @override
  _StatusResult awaitClosed(int handle, int timeoutMilliseconds) =>
      _status((error) => _await(handle, timeoutMilliseconds, error));
  @override
  _StatusResult releaseHandle(int handle) => _status((error) => _release(handle, error));
}
