+// Public companion functions accept only wrappers created by this SDK variant.
+// No raw native handle or private-field inspection is exposed to consumers.
+function checkedRuntime(runtime: Runtime): RuntimeHandle {
+  if (!(runtime instanceof RuntimeHandle)) { throw new BoundaryError('InvalidArgument'); }
+  return runtime;
+}
+function checkedEngine(engine: Engine): EngineHandle {
+  if (!(engine instanceof EngineHandle)) { throw new BoundaryError('InvalidArgument'); }
+  return engine;
+}
+function checkedOperation(operation: Operation): OperationHandle {
+  if (!(operation instanceof OperationHandle)) { throw new BoundaryError('InvalidArgument'); }
+  return operation;
+}
+function checkedSubscription(subscription: Subscription): SubscriptionHandle {
+  if (!(subscription instanceof SubscriptionHandle)) { throw new BoundaryError('InvalidArgument'); }
+  return subscription;
+}
+export function testBootstrapTotals(): number[] { return nativeCall(() => native.testBootstrapTotals()); }
