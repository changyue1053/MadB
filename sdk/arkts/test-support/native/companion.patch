+// This observation channel never uses a foreign env/context. Retired slots are
+// copied into a fixed-size, context-free history before their storage is reused.
+napi_value testObserve(napi_env env, const Handle &h, bool foreignAllowed) {
+    if (h.kind != 'r')
+        return error(env, "InvalidHandle");
+    Owner live;
+    const char *problem = nullptr;
+    if (!foreignAllowed) {
+        std::lock_guard<std::mutex> l(registryMutex);
+        for (auto &s : slots)
+            if (s.epoch == h.runtime) {
+                if (s.env != env || s.thread != std::this_thread::get_id())
+                    problem = "WrongEnv";
+                else
+                    live = s.owner;
+                break;
+            }
+    }
+    if (problem)
+        return error(env, problem);
+    if (live)
+        refresh(*live);
+    std::array<int64_t, 156> values{};
+    bool found = false;
+    {
+        std::lock_guard<std::mutex> l(registryMutex);
+        auto copyCounters = [&](const auto &base, const auto &trace, const auto &hook, bool done,
+                                bool liveSnapshot) {
+            for (size_t i = 0; i < FrameSize; ++i) {
+                const uint64_t a = base[i], b = hook[i];
+                if (a > 9007199254740991ULL || b > 9007199254740991ULL) {
+                    problem = "DiagnosticRangeExceeded";
+                    return;
+                }
+                values[i] = static_cast<int64_t>(a);
+                values[102 + i] = static_cast<int64_t>(b);
+            }
+            for (size_t i = 0; i < 48; ++i)
+                values[54 + i] = trace[i];
+            values[F::Format] = 1;
+            values[F::Phase] = done                                  ? 3
+                               : values[F::MechanismTeardownStarted] ? 2
+                               : values[F::RuntimeCloseRequested]    ? 1
+                                                                     : 0;
+            values[54 + T::TestFormat] = 1;
+            values[54 + T::ReadMode] = done ? 2 : liveSnapshot ? 1 : 0;
+        };
+        for (auto &s : slots)
+            if (s.epoch == h.runtime) {
+                found = true;
+                if (!foreignAllowed && (s.env != env || s.thread != std::this_thread::get_id())) {
+                    problem = "WrongEnv";
+                    break;
+                }
+                std::lock_guard<std::mutex> trace(s.audit.testMutex);
+                copyCounters(s.audit.c, s.audit.test, s.audit.hookEntry, physical(s.audit),
+                             bool(live));
+                break;
+            }
+        if (!found)
+            for (const auto &old : history)
+                if (old.epoch == h.runtime) {
+                    found = true;
+                    if (!foreignAllowed &&
+                        (old.env != env || old.thread != std::this_thread::get_id())) {
+                        problem = "WrongEnv";
+                        break;
+                    }
+                    copyCounters(old.values, old.test, old.hook, old.physicalAck, false);
+                    break;
+                }
+    }
+    if (problem)
+        return error(env, problem);
+    if (!found)
+        return error(env, "ObservationExpired");
+    return testNumbers(env, values);
+}
