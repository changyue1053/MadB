+        return MP_INVALID_ARGUMENT;
+    if (atomic_load(&ctx->live))
+        return MP_BUSY;
+    ctx->memory = observer;
+    memory(ctx, sizeof(c_model), 0, 0);
+    return MP_OK;
+}
