+extern "C" mp_status mp_cpp_test_memory_bind(void *opaque,
+                                             mp_test_memory_observer observer) noexcept {
+    if (!opaque || !observer.context || !observer.notify)
+        return MP_INVALID_ARGUMENT;
+    auto &ctx = *static_cast<Context *>(opaque);
+    if (ctx.memory.notify &&
+        (ctx.memory.notify != observer.notify || ctx.memory.context != observer.context))
+        return MP_INVALID_ARGUMENT;
+    if (ctx.live.load())
+        return MP_BUSY;
+    ctx.memory = observer;
+    memory(ctx, sizeof(Model), 0, 0);
+    return MP_OK;
+}
