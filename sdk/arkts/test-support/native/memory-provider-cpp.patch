+size_t textStorage(const std::string &text) noexcept {
+    auto first = reinterpret_cast<uintptr_t>(&text),
+         data = reinterpret_cast<uintptr_t>(text.data());
+    return data >= first && data - first < sizeof(text) ? 0 : text.capacity() + 1;
+}
+void memory(Context &ctx, uint64_t object, uint64_t text, uint32_t action) noexcept {
